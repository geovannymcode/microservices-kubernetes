# Copy to .env and fill in MONGO_PASSWORD. Spring Boot does not read .env: export it (set -a; . ./.env; set +a).
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=db_notify
MONGO_USER=notify
MONGO_PASSWORD=
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Delivery channel: log (default) or webhook. With webhook, NOTIFY_WEBHOOK_URL is required (the app does not start
# without it). Local receiver: docker compose --profile tools up -d webhook-receiver (repo root).
# NOTIFICATION_SENDER_TYPE=webhook
# NOTIFY_WEBHOOK_URL=http://localhost:8086/notifications
# Optional: signs each body with HMAC-SHA256 (header X-Signature, hex).
# NOTIFY_WEBHOOK_SECRET=
