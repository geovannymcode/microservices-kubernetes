DB_HOST=localhost
DB_PORT=3306
DB_NAME=inventory
DB_USER=inventory
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Observabilidad (opcional). Con el perfil observability de Compose los valores por defecto ya sirven.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# TRACING_SAMPLING=1.0
# OTEL_METRICS_EXPORTER=otlp
# Order Service (PostgreSQL). POSTGRES_PASSWORD must match DB_PASSWORD in order-service/.env.
POSTGRES_DB=orderdb
POSTGRES_USER=order
POSTGRES_PASSWORD=
# Notification Service (MongoDB). The root user only initializes the database; the service uses MONGO_USER.
# MONGO_DB, MONGO_USER and MONGO_PASSWORD must match notify-service/.env.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=
MONGO_DB=db_notify
MONGO_USER=notify
MONGO_PASSWORD=
