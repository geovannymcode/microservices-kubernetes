DB_HOST=localhost
DB_PORT=3306
DB_NAME=inventory
DB_USER=inventory
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Observabilidad (opcional). Con el perfil observability de Compose los valores por defecto ya sirven.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# TRACING_SAMPLING=1.0
# OTEL_METRICS_EXPORTER=otlp
# Order Service (PostgreSQL). POSTGRES_PASSWORD must match DB_PASSWORD in order-service/.env.
POSTGRES_DB=orderdb
POSTGRES_USER=order
POSTGRES_PASSWORD=
